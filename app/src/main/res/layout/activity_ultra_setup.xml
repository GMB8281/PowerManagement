<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:background="?attr/colorSurface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configurar Ultra-Econômico"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecione os aplicativos que poderão ser usados durante o modo Ultra-Econômico (máximo 8)."
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:gravity="center"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btn_choose_apps"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Escolher Aplicativos"
        android:textAppearance="?attr/textAppearanceTitleMedium"/>

    <Button
        android:id="@+id/btn_conclude"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:text="Concluir"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
</LinearLayout>